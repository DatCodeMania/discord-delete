Output demo/demo.gif
Output demo/demo.mp4

Set Shell "bash"
Set Width 1600
Set Height 1200
Set FontSize 24
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set Theme "nord"

Set WindowBar Colorful
Set BorderRadius 12
Set Margin 70
Set MarginFill "#5E81AC"
Set Padding 24

Set TypingSpeed 120ms
Set CursorBlink false
Set PlaybackSpeed 0.7
Set Framerate 60
Set WaitTimeout 15s

Hide
Type "export DEV_DISCORD_DELETE_DEMO=1 && go build -o discord-delete . && clear"
Enter
Sleep 3
Show

Type "./discord-delete"
Sleep 500ms
Enter
Sleep 2500ms

Type@120ms "demo/demo-package.zip"
Sleep 1200ms
Enter
Sleep 2000ms

Type "c"
Sleep 2000ms

Space
Sleep 1200ms
Down
Sleep 600ms
Space
Sleep 1300ms

Down
Sleep 150ms
Down
Sleep 150ms
Down
Sleep 150ms
Down
Sleep 150ms
Down
Sleep 800ms
Enter
Sleep 1200ms

Type "n"
Sleep 800ms
Down
Sleep 500ms
Space
Sleep 900ms
Down
Sleep 400ms
Space
Sleep 900ms
Down
Down
Down
Sleep 400ms
Space
Sleep 1200ms

Escape
Sleep 700ms
Escape
Sleep 900ms

Enter
Sleep 2500ms
